# ==============================================================================
# Environment Configuration Template: Intangible Heritage Website
# ==============================================================================
#
# IMPORTANT:
# - Do NOT commit `.env` or `.env.production` files containing real secrets to Git.
# - In CapRover, set these environment variables under App > App Configs > Environmental Variables.
# - Next.js client-side variables prefixed with `NEXT_PUBLIC_*` are embedded at build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration (CapRover App Configs)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Canonical Public Domain for SEO and metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 2. Email Service (Optional: Nodemailer / SMTP Configuration)
# ------------------------------------------------------------------------------
# Configure these in CapRover Environmental Variables if you enable server-side contact emailing.
# Never expose these through NEXT_PUBLIC_* or Docker build arguments.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-password-placeholder
SMTP_FROM="Intangible Heritage <noreply@your-domain.com>"
CONTACT_RECEIVER_EMAIL=info@your-domain.com
